# Render production environment for the DevFlow API.
# Copy this file to `.env.render.local`, fill in the real values, then import it in Render.
# Do not set PORT. Render provides PORT automatically.

NODE_ENV=production
NODE_VERSION=22

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Better Auth
# Generate a 32+ character secret, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-production-secret
BETTER_AUTH_URL=https://your-render-service.onrender.com
SERVER_URL=https://your-render-service.onrender.com
CLIENT_URL=https://your-vercel-app.vercel.app


# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
